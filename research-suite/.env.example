# Copy to .env and fill in what you have. Every key is optional.
#
# .env is git-ignored. Never commit a filled-in copy: this repository publishes a
# GitHub Pages site from its own branch, so a committed key would be served as a
# static file at a guessable URL. A key that has ever been committed must be
# rotated — rewriting history does not unpublish it.
#
# On macOS and Windows the Settings page stores keys in the OS keychain instead
# of here, which is better. This file is the fallback for headless Linux.

# Sent to NCBI, Crossref, OpenAlex and Unpaywall in the User-Agent header so
# those APIs can identify the client, as their usage policies ask. Unpaywall
# requires it. Not sent anywhere else.
RESEARCH_SUITE_EMAIL=

# Drafting. Without it, everything except AI-assisted drafting still works.
ANTHROPIC_API_KEY=

# Raises PubMed's rate limit from 3 to 10 requests per second.
NCBI_API_KEY=

# Required since February 2026 — anonymous OpenAlex callers get about 100
# credits a day, which one literature search spends. Free signup.
OPENALEX_API_KEY=

# Optional extras.
SEMANTIC_SCHOLAR_API_KEY=
SCOPUS_API_KEY=
COPYLEAKS_API_KEY=

# Interface and port. Leave as 127.0.0.1 unless you have put an authenticating
# proxy in front of the app — see app/security.py for why.
RESEARCH_SUITE_HOST=127.0.0.1
RESEARCH_SUITE_PORT=8765

# One of: Times New Roman, Calibri, Arial, Georgia, Lucida Sans Unicode,
# Computer Modern (APA 7 §2.19).
RESEARCH_SUITE_FONT=Times New Roman

# Self-hosted grammar checking. Start a server with:
#   docker run -d -p 8081:8010 erikvl87/languagetool
LANGUAGETOOL_URL=http://localhost:8081/v2/check
