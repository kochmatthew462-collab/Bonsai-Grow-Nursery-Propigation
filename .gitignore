__pycache__/
*.pyc
test/reference.json
screenshots/
pi/config.json
*.db

# Secrets. The repo publishes a GitHub Pages site from its own branch, so a
# committed .env would be served as a static file at a guessable URL. A key that
# has ever been committed must be rotated — rewriting history does not
# unpublish it.
.env
.env.*
!.env.example
