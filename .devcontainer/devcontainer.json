{
  "name": "Koch Clinical Suite",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  // Without this the port is never forwarded and the *.app.github.dev URL
  // returns 404 while the application is running perfectly well inside the
  // container. Declaring it here means the port exists from the moment the
  // codespace starts, rather than only once something binds to it.
  "forwardPorts": [8765, 3000],
  "portsAttributes": {
    "8765": {
      "label": "Koch Clinical Suite",
      // Opens the browser as soon as the app binds, so nobody has to find the
      // PORTS panel or copy a URL out of the terminal. The whole reason this
      // file exists is that a forwarded port nobody told the editor about
      // produces a 404 that looks like a broken application.
      "onAutoForward": "openBrowser",
      // Private: reachable by the codespace owner's GitHub account and nobody
      // else. Do not change this to "public" — the session token would become
      // the only protection, and it travels in the URL.
      "visibility": "private",
      "onAutoForward": "openBrowser"
    },
    "3000": {
      "label": "Koch Clinical Suite (alternate port)",
      "visibility": "private",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "cd research-suite && python -m pip install --quiet -r requirements.txt",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
